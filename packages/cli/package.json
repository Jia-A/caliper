{
  "name": "caliper-ai",
  "version": "0.3.0",
  "description": "Measure time from click to first painted output for AI features in a real browser, and break it down by network phase.",
  "keywords": [
    "playwright",
    "ai",
    "llm",
    "performance",
    "latency",
    "ttft",
    "web-vitals"
  ],
  "author": "Jiya Agrawal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jia-A/caliper.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Jia-A/caliper#readme",
  "bin": {
    "caliper": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test:csp": "node --test test/csp.test.ts",
    "test:canary": "npm run -s build >/dev/null && node test/canary.test.mjs",
    "prepublishOnly": "npm run typecheck && npm run build",
    "test:nostore": "npm run -s build >/dev/null && node test/nostore.test.mjs",
    "test:chat": "npm run -s build >/dev/null && node test/chat.test.mjs"
  }
}
