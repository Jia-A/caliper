{
  "name": "caliper-timings",
  "version": "0.6.0",
  "description": "Server side of Caliper's server timings: records when a marked request reaches each step, for caliper-ai to read back.",
  "keywords": [
    "caliper",
    "ai",
    "llm",
    "performance",
    "latency",
    "server-timing"
  ],
  "author": "Jiya Agrawal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jia-A/caliper.git",
    "directory": "packages/timings"
  },
  "homepage": "https://github.com/Jia-A/caliper#readme",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "default": "./dist/fetch.js"
    },
    "./workers": {
      "types": "./dist/workers.d.ts",
      "default": "./dist/workers.js"
    },
    "./upstash": {
      "types": "./dist/upstash.d.ts",
      "default": "./dist/upstash.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "SPEC.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-timeout=20000 test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2"
  }
}
